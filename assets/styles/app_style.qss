/* CaseWatch — Linear/Notion Inspired Minimal Theme */

QWidget {
    background-color: #ffffff;
    color: #111827; /* Gray 900 */
    font-family: Helvetica, Arial, sans-serif;
    font-size: 13px;
}

/* === Main Window & Dialogs === */
QMainWindow, QDialog {
    background-color: #ffffff;
}

/* === Headers & Text === */
QLabel {
    background-color: transparent;
    color: #374151; /* Gray 700 */
}

QLabel#titleText {
    font-size: 24px;
    font-weight: 700;
    color: #111827; /* Gray 900 */
    letter-spacing: -0.5px;
}

QLabel#subtitleText {
    font-size: 13px;
    color: #6b7280; /* Gray 500 */
}

QLabel#stepNumber {
    background-color: #eff6ff; /* Blue 50 */
    color: #3b82f6; /* Blue 500 */
    border-radius: 12px;
    font-weight: bold;
    font-size: 13px;
    qproperty-alignment: AlignCenter;
}

QLabel#stepTitle {
    font-size: 15px;
    font-weight: 600;
    color: #111827; /* Gray 900 */
}

QLabel#guidelinesTitle {
    color: #111827;
    font-weight: 500;
}

/* === Custom Layout Frames === */
QFrame#guidelinesFrame {
    background-color: #f8fafc; /* Slate 50 */
    border: 1px solid #e2e8f0; /* Slate 200 */
    border-radius: 6px;
}

QFrame#dashedFrame {
    background-color: #f8fafc;
    border: 2px dashed #94a3b8; /* Darker slate 400 */
    border-radius: 6px;
}

QFrame#warningFrame {
    background-color: transparent;
    border: none;
}
QLabel#warningIcon {
    color: #f97316;
}

/* === Inputs === */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db; /* Gray 300 */
    border-radius: 4px;
    padding: 6px 8px;
    color: #111827;
    font-size: 13px;
    min-height: 24px;
}

QLineEdit:focus {
    border: 1px solid #3b82f6; /* Blue 500 */
    outline: none;
}

QLineEdit:read-only {
    background-color: transparent;
    border: none;
    color: #111827;
}

/* === QSpinBox Buttons === */
QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 28px 6px 8px; /* Leave room for arrows on the right */
    color: #111827;
    font-size: 13px;
    min-height: 24px;
}
QSpinBox:focus {
    border: 1px solid #3b82f6;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 24px;
    background-color: #f8fafc;
    border-left: 1px solid #e2e8f0;
}
QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 3px;
}
QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 3px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #e2e8f0;
}
QSpinBox::up-arrow {
    image: url("assets/icons/up_arrow.svg");
    width: 14px;
    height: 14px;
}
QSpinBox::down-arrow {
    image: url("assets/icons/down_arrow.svg");
    width: 14px;
    height: 14px;
}


/* === Buttons === */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d1d5db; /* Gray 300 */
    border-radius: 6px;
    color: #374151; /* Gray 700 */
    padding: 6px 16px;
    font-weight: 500;
    font-size: 13px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #f9fafb; /* Gray 50 */
    border-color: #9ca3af;
}

QPushButton:pressed {
    background-color: #f3f4f6; /* Gray 100 */
}

QPushButton#primaryAction {
    background-color: #3b82f6; /* Blue 500 */
    border: 1px solid #2563eb; /* Blue 600 */
    color: #ffffff;
}

QPushButton#primaryAction:hover {
    background-color: #2563eb;
}

QPushButton#primaryAction:disabled {
    background-color: #9ca3af;
    border-color: #9ca3af;
    color: #f3f4f6;
}

QPushButton#secondaryAction {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    color: #374151;
}
QPushButton#secondaryAction:hover {
    background-color: #f9fafb;
}

QPushButton#ghostAction {
    background-color: transparent;
    border: 1px solid transparent;
    color: #374151;
}
QPushButton#ghostAction:hover {
    background-color: #f3f4f6;
    border: 1px solid #e5e7eb;
}

/* === Case Table === */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    gridline-color: #f3f4f6;
    color: #111827;
    alternate-background-color: #fafafa;
    font-size: 13px;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #eff6ff; /* Blue 50 */
    color: #1e40af;
}

QHeaderView::section {
    background-color: #ffffff;
    color: #6b7280;
    font-weight: 500;
    padding: 10px;
    border: none;
    border-right: 1px solid #f3f4f6;
    border-bottom: 1px solid #e5e7eb;
}

/* === Status Bar === */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
}

/* === Menus === */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    color: #111827;
}

QMenuBar::item:selected {
    background-color: #f3f4f6;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    color: #111827;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3b82f6;
    color: #ffffff;
    border-radius: 4px;
}

QFrame#HLine {
    color: #e5e7eb;
}
